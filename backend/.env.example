cd D:\RAS_bavarchi\RasaBavarchi\backend

@'
# =========================================================
# RasaBavarchi Backend - Environment Variables
# =========================================================

# Application
APP_NAME=RasaBavarchi API
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8000

# =========================================================
# Database
# =========================================================

# Production PostgreSQL connection
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/rasabavarchi

# Master database connection
MASTER_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/MASTER_DATABASE

# =========================================================
# JWT
# =========================================================

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =========================================================
# Email / SMTP
# =========================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=RasaBavarchi

# =========================================================
# Gemini
# =========================================================

GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=models/gemini-3.6-flash

# =========================================================
# ElevenLabs
# =========================================================

ELEVENLABS_API_KEY=CHANGE_ME
ELEVENLABS_VOICE_ID=CHANGE_ME

# =========================================================
# YouTube
# =========================================================

YOUTUBE_API_KEY=CHANGE_ME
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3/search

# =========================================================
# Pexels
# =========================================================

PEXELS_API_KEY=CHANGE_ME
'@ | Set-Content .env.example